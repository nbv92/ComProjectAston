<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="PanelController">
    <TextField fx:id="randomField" promptText="Введите случайное число"/>
    <Button fx:id="randomButton" text="Создать случайные автобусы"/>
    <ComboBox fx:id="sortingOptions">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Sort by Number"/>
                <String fx:value="Sort by Model"/>
                <String fx:value="Sort by Mileage"/>
                <String fx:value="SortByMultipleFields"/>
                <String fx:value="SortByEvenOddField"/>
            </FXCollections>
        </items>
    </ComboBox>
    <Button fx:id="sortButton" text="Сортировать"/>
    <Button fx:id="backButton" text="Назад"/>
</VBox>